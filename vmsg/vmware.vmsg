msg.fusion.setting.bootCampAuth.description = "Boot Camp 磁盘的管理员权限"
msg.fusion.setting.bootCampAuth.detail = "关闭身份验证后，当前用户无需提供管理员用户名和密码即可访问 Boot Camp 分区或其他物理磁盘。"
msg.fusion.setting.cdrom.clearRecent = "清除最近使用的项目"
msg.fusion.setting.cdrom.recentItems = "最近使用的项目"
msg.fusion.setting.cdromOpenPanelMessage = "选取光盘或光盘映像。"
msg.fusion.setting.cpu.numberOfCore = "%s 个处理器核心"
msg.fusion.setting.cpu.numberOfCores = "%s 个处理器核心"
msg.fusion.setting.cpu.oneCore = "%3d  个处理器核心"
msg.fusion.setting.cpu.otherCores = "其他：%3d  个处理器核心"
msg.fusion.setting.cpu.supportedOfCores = "%3d  个处理器核心"
msg.fusion.setting.darkModeSync.description = "启用深色模式同步"
msg.fusion.setting.darkModeSync.detail = "启用此选项将为该虚拟机开启深色模式同步。|0A此功能支持 Windows 10 与 macOS 10.11 及更高版本的虚拟机，且需要较新的 VMware Tools。"
msg.fusion.setting.firmwareType.description = "固件类型"
msg.fusion.setting.firmwareType.detail = "指定此虚拟机的引导固件类型。更改此选项可能导致已安装的客户机操作系统无法引导。"
msg.fusion.setting.hardDiskBuffer.description = "硬盘缓冲"
msg.fusion.setting.hardDiskBuffer.detail = "硬盘缓冲可提升虚拟机性能，但也会占用 Mac 上更多的内存。若设为“自动”，VMware Fusion 会根据虚拟机的操作系统决定是否启用硬盘缓冲。"
msg.fusion.setting.monitorType.description = "疑难解答"
msg.fusion.setting.monitorType.detail = "选择“无”可让虚拟机以最快速度运行且不收集任何疑难解答信息。选择“挂起/崩溃”有助于排查正确性问题，例如虚拟机挂起或崩溃。选择“性能”有助于排查性能问题，例如虚拟机内部操作过慢。"
msg.fusion.setting.network.NAT_Info = "此虚拟机与 Mac 共享外部网络上的同一 IP 地址。Mac 会为来自该虚拟机的网络流量提供网络地址转换 (NAT)。"
msg.fusion.setting.network.autodetectTitle = "自动检测"
msg.fusion.setting.network.bridgedAutodetectInfo = "虚拟机会作为一台额外的电脑，出现在与 Mac 相同的物理网络连接上。"
msg.fusion.setting.network.bridgedNetworkingTitle = "桥接网络"
msg.fusion.setting.network.customTitle = "自定义"
msg.fusion.setting.network.hostOnlyInfo = "虚拟机通过专用虚拟网络与您的 Mac 连接。该专用网络通常无法从 Mac 所在的物理网络访问。|0A多台虚拟机可以同时使用此网络。"
msg.fusion.setting.network.internetSharingTitle = "互联网共享"
msg.fusion.setting.network.privateTitle = "我的 Mac 专用"
msg.fusion.setting.network.shareWithMacTitle = "与我的 Mac 共享"
msg.fusion.setting.network.unknownInfo = "您的 Mac 不支持此配置。"
msg.fusion.setting.network.unknownTitle = "未知"
msg.fusion.setting.network.unrecognizedDevice = "无法识别的网络设备：%s"
msg.fusion.setting.network.unrecognizedUnnamedDevice = "无法识别的网络设备"
msg.fusion.setting.powerOffOptions.detail = "“%s”会向客户机操作系统发送关机信号。“%s”的作用相当于电脑电源上的电源开关，此操作可能导致数据丢失。"
msg.fusion.setting.powerOptions.description = "电源选项"
msg.fusion.setting.powerOptions.hardString = "%s（硬）"
msg.fusion.setting.powerResetOptions.detail = "“%s”会向客户机操作系统发送重新启动信号。“%s”的作用相当于复位开关，此操作可能导致数据丢失。"
msg.fusion.setting.powerResumeOptions.detail = "“恢复”（软选项）会触发运行恢复脚本。两个选项都会恢复虚拟机。"
msg.fusion.setting.powerSuspendOptions.detail = "“%s”会触发运行挂起脚本。两个选项都会挂起虚拟机。"
msg.fusion.setting.removeDevice.generic.messageText = "确定要移除“%s”吗？"
msg.fusion.setting.secureBoot.description = "启用 UEFI 安全启动"
msg.fusion.setting.secureBoot.detail = "启用此选项将为该虚拟机开启 UEFI 安全启动。此选项仅在硬件版本 13 及以上的虚拟机中可用。更改此选项可能导致已安装的客户机操作系统无法引导。"
msg.fusion.setting.startup.floppy = "软盘"
msg.fusion.setting.startup.optical = "CD/DVD"
msg.fusion.setting.syncTime.description = "同步时间"
msg.fusion.setting.syncTime.detail = "将虚拟机中的时间与 Mac 的当前时间同步。"
msg.fusion.setting.syncTime.remote.detail = "将虚拟机中的时间与远程服务器的当前时间同步。"
msg.fusion.setting.ulm.sideChanMiti.description = "禁用侧信道缓解"
msg.fusion.setting.ulm.sideChanMiti.detail = "启用此选项将禁用该虚拟机的侧信道缓解。|0A"
msg.fusion.setting.usbConnectAsk = "询问要执行的操作"
msg.fusion.setting.usbConnectToLinux = "连接到 Linux"
msg.fusion.setting.usbConnectToVM = "连接到虚拟机"
msg.fusion.setting.usbConnectToWindows = "连接到 Windows"
msg.fusion.setting.usbConnectVMDefault = "使用默认操作"
msg.fusion.setting.verboseUSBLogging.description = "启用详细 USB 调试"
msg.fusion.setting.verboseUSBLogging.detail = "启用后记录虚拟 USB 堆栈的详细日志，便于排查问题。"
msg.fusion.setting.virtualBattery.description = "将电源状态传递给虚拟机"
msg.fusion.setting.virtualBattery.detail = "更改电源传递设置需要先关闭操作系统、关闭虚拟机电源，然后重新启动虚拟机。您可以现在更改，也可以在虚拟机关机时更改。"
msg.fusion.setting.vncEnabled.description = "通过 VNC 远程显示"
msg.fusion.setting.vncEnabled.detail = "启用此选项后，任何 VNC 客户端都可以通过连接这台 Mac 的主机名或 IP 地址远程访问该虚拟机。如果您还启用了远程管理，请注意相关设置。"
msg.fusion.setting.vncPassword.description = "密码（推荐）"
msg.fusion.setting.vncPasswordKey.detail = "某些 VNC 配置需要密码。若未设置，您网络上的任何人都可能访问此虚拟机。|0A|0A密码将以加密值形式存储。"
msg.fusion.setting.vncPort.description = "端口"
msg.fusion.setting.vncPort.detail = "如果已在 Mac OS X 中启用远程管理，请点击下方的“帮助”按钮获取正确的设置说明。"
